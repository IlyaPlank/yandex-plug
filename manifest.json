{
  "manifest_version": 3,
  "name": "Yandex fix",
  "version": "1.0.0",
  "description": "Custom UI tweaks",
  "permissions": ["storage"],
  "host_permissions": ["https://music.yandex.ru/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Settings"
  },
  "content_scripts": [
    {
      "matches": ["https://music.yandex.ru/*"],
      "js": ["content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle"
    }
  ]
}
