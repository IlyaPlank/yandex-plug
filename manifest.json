{
  "manifest_version": 3,
  "name": "Yandex plug",
  "version": "1.0.0",
  "description": "Custom UI tweaks",
  "permissions": ["storage", "declarativeContent"],
  "host_permissions": ["https://music.yandex.ru/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://music.yandex.ru/*"],
      "js": ["content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
